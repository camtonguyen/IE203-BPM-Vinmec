    <bpmn:task id="T_NhapVien" name="Lập chỉ định nhập viện">
      <bpmn:incoming>F57</bpmn:incoming>
      <bpmn:outgoing>F58</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_NoiTru" name="Chuyển nội trú">
      <bpmn:documentation>Tạm ứng nhập viện và thanh toán ra viện (Bước 7, 8 của Vinmec) thuộc nội trú, ngoài C1. ⚠ Chưa mô hình hóa thanh toán khoản ngoại trú và tạm ứng của ca này: QLHC09</bpmn:documentation>
      <bpmn:incoming>F58</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G12_DonThuoc" name="Cần kê đơn thuốc?">
