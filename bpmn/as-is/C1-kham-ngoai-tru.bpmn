<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_C1" targetNamespace="https://github.com/camtonguyen/IE203-BPM-Vinmec" exporter="IE203 nhóm" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_C1">
    <bpmn:documentation>C1 Khám ngoại trú, mô hình as-is (T32). Nguồn: docs/processes/C1-kham-ngoai-tru.md (T11); trang Vinmec "Quy trình khám chữa bệnh tại Vinmec" và "Thủ tục thanh toán bảo hiểm tại Vinmec" (truy cập 27/11/2026). Các bước ⚠ là giả định chưa có nguồn công khai, chờ xác minh qua phỏng vấn T24–T26 và số liệu T27.</bpmn:documentation>
    <bpmn:participant id="P_TuyenTren" name="Khoa chuyên khoa khác / Bệnh viện tuyến trên" />
    <bpmn:participant id="P_Vinmec" name="Bệnh viện Vinmec – Khám ngoại trú" processRef="Process_C1" />
    <bpmn:participant id="P_BaoHiem" name="Công ty bảo hiểm / Cơ quan BHXH" />
    <bpmn:messageFlow id="MF_GiayChuyen" name="Giấy chuyển viện" sourceRef="T_ChuyenVien" targetRef="P_TuyenTren" />
    <bpmn:messageFlow id="MF_YeuCauBL" name="Hồ sơ yêu cầu bảo lãnh" sourceRef="T_YeuCauBaoLanh" targetRef="P_BaoHiem" />
    <bpmn:messageFlow id="MF_KetQuaBL" name="Kết quả bảo lãnh" sourceRef="P_BaoHiem" targetRef="T_YeuCauBaoLanh" />
  </bpmn:collaboration>
